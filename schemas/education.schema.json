{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "institution": {
        "type": "string",
        "minLength": 1
      },
      "degree": {
        "type": "string",
        "minLength": 1
      },
      "field": {
        "type": "string"
      },
      "start": {
        "anyOf": [
          {
            "type": "integer",
            "minimum": 1900,
            "maximum": 2100
          },
          {
            "type": "string",
            "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$"
          }
        ]
      },
      "end": {
        "anyOf": [
          {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1900,
                "maximum": 2100
              },
              {
                "type": "string",
                "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$"
              }
            ]
          },
          {
            "type": "string",
            "const": "present"
          }
        ]
      },
      "notes": {
        "type": "string"
      }
    },
    "required": ["institution", "degree"]
  }
}
