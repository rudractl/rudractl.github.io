{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "institution": {
        "type": "string",
        "minLength": 1
      },
      "degree": {
        "type": "string",
        "minLength": 1
      },
      "field": {
        "type": "string"
      },
      "start": {
        "anyOf": [
          {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          {
            "type": "string",
            "pattern": "^\\d{4}(-\\d{2})?$"
          }
        ]
      },
      "end": {
        "anyOf": [
          {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          {
            "type": "string",
            "pattern": "^\\d{4}(-\\d{2})?$"
          }
        ]
      },
      "notes": {
        "type": "string"
      }
    },
    "required": ["institution", "degree"]
  }
}
