{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "status": {
      "default": "active",
      "type": "string",
      "enum": ["planned", "active", "complete", "paused"]
    },
    "technologies": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "repository": {
      "type": ["string", "null"]
    },
    "started": {},
    "featured": {
      "default": false,
      "type": "boolean"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": ["name", "summary"]
}
