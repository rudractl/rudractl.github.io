{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "group": {
        "type": "string",
        "minLength": 1
      },
      "items": {
        "minItems": 1,
        "type": "array",
        "items": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "note": {
                  "type": "string"
                }
              },
              "required": ["name"]
            }
          ]
        }
      }
    },
    "required": ["group", "items"]
  }
}
