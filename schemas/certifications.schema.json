{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "name": {
        "type": "string",
        "minLength": 1
      },
      "issuer": {
        "type": "string",
        "minLength": 1
      },
      "issued": {},
      "expires": {
        "anyOf": [
          {},
          {
            "type": "null"
          }
        ]
      },
      "credential_url": {
        "anyOf": [
          {
            "type": "string",
            "format": "uri"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "required": ["name", "issuer", "issued"]
  }
}
