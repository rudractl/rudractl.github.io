{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "company": {
        "type": "string",
        "minLength": 1
      },
      "role": {
        "type": "string",
        "minLength": 1
      },
      "start": {
        "anyOf": [
          {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          {
            "type": "string",
            "pattern": "^\\d{4}(-\\d{2})?$"
          }
        ]
      },
      "end": {
        "anyOf": [
          {
            "anyOf": [
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "string",
                "pattern": "^\\d{4}(-\\d{2})?$"
              }
            ]
          },
          {
            "type": "string",
            "const": "present"
          }
        ]
      },
      "location": {
        "type": "string"
      },
      "summary": {
        "type": "string",
        "minLength": 1
      },
      "areas": {
        "default": [],
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "highlights": {
        "default": [],
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "required": ["company", "role", "start", "end", "summary"]
  }
}
