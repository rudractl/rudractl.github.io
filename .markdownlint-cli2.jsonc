{
  // Lints authored writing. Long lines and inline HTML are fine in prose.
  "config": {
    "default": true,
    "MD013": false,
    "MD033": false,
    "MD041": false,
    "MD024": { "siblings_only": true },
    "MD025": false,
  },
  "globs": ["content/**/*.{md,mdx}", "README.md", "CONTRIBUTING.md"],
  "ignores": ["node_modules", "dist"],
}
