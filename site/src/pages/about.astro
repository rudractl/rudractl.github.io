---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import TerminalWindow from '@/components/terminal/TerminalWindow.astro';
import Prompt from '@/components/terminal/Prompt.astro';
import ExperienceTimeline from '@/components/portfolio/ExperienceTimeline.astro';
import SkillGroups from '@/components/portfolio/SkillGroups.astro';
import ContactBlock from '@/components/portfolio/ContactBlock.astro';
import Icon from '@/components/Icon.astro';
import {
  getCertifications,
  getEducation,
  getExperience,
  getProfile,
  getSkills,
} from '@/lib/data.ts';
import { renderMarkdown } from '@/lib/markdown.ts';
import { formatPartialDate, partialToDate } from '@/lib/format.ts';

const profile = getProfile();
const experience = getExperience();
const education = getEducation();
const certifications = getCertifications();
const skills = getSkills();
const summary = await renderMarkdown(profile.summary);
const now = new Date();
---

<BaseLayout
  title="About"
  description={`${profile.name} — ${profile.role}. ${profile.intro.trim()}`}
  type="profile"
>
  <div class="container-page pt-12 sm:pt-16">
    <!-- Hero -->
    <section class="grid items-start gap-10 lg:grid-cols-[1fr_1.1fr]">
      <TerminalWindow title="profile — zsh" class="enter">
        <Prompt command="rudractl profile" short="profile" />
        <h1 class="mt-5 font-sans text-3xl font-semibold tracking-tight text-fg sm:text-4xl">
          {profile.name}
        </h1>
        <p class="mt-2 font-sans text-lg text-accent">{profile.role}</p>
        <p class="mt-4 font-sans leading-relaxed text-fg-2">{profile.intro}</p>
        <dl class="mt-5 grid grid-cols-[6rem_1fr] gap-y-2 text-[0.8125rem]">
          {profile.location && (
            <>
              <dt class="text-muted">location</dt>
              <dd>{profile.location}</dd>
            </>
          )}
          {profile.availability && (
            <>
              <dt class="text-muted">status</dt>
              <dd class="text-accent">{profile.availability}</dd>
            </>
          )}
        </dl>
      </TerminalWindow>
      <div class="enter" style="--i:1">
        <p class="eyebrow mb-4">
          <span class="prompt">$</span> cat README.md
        </p>
        <div class="prose prose-site" set:html={summary} />
      </div>
    </section>

    <!-- Skills -->
    {skills.length > 0 && (
      <section class="mt-24">
        <SectionHeading
          command="rudractl skills --grouped"
          title="Skills & Technologies"
          description="Grouped by area — no percentage bars."
        />
        <SkillGroups groups={skills} />
      </section>
    )}

    <!-- Experience -->
    {experience.length > 0 && (
      <section class="mt-24">
        <SectionHeading command="rudractl history --timeline" title="Experience" />
        <ExperienceTimeline items={experience} />
      </section>
    )}

    <!-- Education & certifications -->
    {(education.length > 0 || certifications.length > 0) && (
      <section class="mt-24 grid gap-12 lg:grid-cols-2">
        {education.length > 0 && (
          <div>
            <SectionHeading command="rudractl education" title="Education" />
            <ul class="space-y-4">
              {education.map((e) => (
                <li class="card reveal flex gap-4 p-5">
                  <Icon name="school" size={18} class="mt-0.5 text-accent" />
                  <div>
                    <h3 class="font-semibold text-fg">
                      {e.degree}
                      {e.field && <span class="font-normal text-fg-2"> · {e.field}</span>}
                    </h3>
                    <p class="mt-1 text-sm text-fg-2">{e.institution}</p>
                    {(e.start || e.end) && (
                      <p class="mt-1 font-mono text-xs text-muted">
                        {e.start && `${formatPartialDate(e.start)} — `}
                        {e.end === 'present' ? (
                          <span class="text-accent">in progress</span>
                        ) : (
                          e.end && formatPartialDate(e.end)
                        )}
                      </p>
                    )}
                    {e.notes && <p class="mt-2 text-sm text-muted">{e.notes}</p>}
                  </div>
                </li>
              ))}
            </ul>
          </div>
        )}
        {certifications.length > 0 && (
          <div>
            <SectionHeading command="rudractl certs" title="Certifications" />
            <ul class="space-y-4">
              {certifications.map((c) => {
                const expired = c.expires ? partialToDate(c.expires, true) < now : false;
                return (
                  <li class="card reveal flex gap-4 p-5">
                    <Icon name="award" size={18} class="mt-0.5 text-accent" />
                    <div class="min-w-0 flex-1">
                      <h3 class="font-semibold text-fg">
                        {c.credential_url ? (
                          <a class="link" href={c.credential_url}>
                            {c.name}
                          </a>
                        ) : (
                          c.name
                        )}
                      </h3>
                      <p class="mt-1 text-sm text-fg-2">{c.issuer}</p>
                      <p class="mt-1 font-mono text-xs text-muted">
                        issued {formatPartialDate(c.issued)}
                        {c.expires && (
                          <span class={expired ? 'text-warning' : ''}>
                            {' '}
                            · {expired ? 'expired' : 'valid until'} {formatPartialDate(c.expires)}
                          </span>
                        )}
                      </p>
                    </div>
                  </li>
                );
              })}
            </ul>
          </div>
        )}
      </section>
    )}

    <!-- Achievements, languages, life outside work -->
    {(profile.achievements.length > 0 ||
      profile.languages.length > 0 ||
      profile.hobbies.length > 0) && (
      <section class="mt-24 grid gap-5 md:grid-cols-3">
        {profile.achievements.length > 0 && (
          <div class="card reveal p-5">
            <h2 class="font-mono text-sm font-medium text-fg">
              <span class="text-accent">#</span> achievements
            </h2>
            <ul class="mt-4 space-y-3">
              {profile.achievements.map((a) => (
                <li class="flex gap-3 text-sm">
                  <Icon name="award" size={16} class="mt-0.5 text-accent" />
                  <span>
                    <span class="text-fg">{a.title}</span>
                    {a.issuer && <span class="block text-muted">{a.issuer}</span>}
                  </span>
                </li>
              ))}
            </ul>
          </div>
        )}
        {profile.languages.length > 0 && (
          <div class="card reveal p-5">
            <h2 class="font-mono text-sm font-medium text-fg">
              <span class="text-accent">#</span> languages
            </h2>
            <dl class="mt-4 grid grid-cols-[1fr_auto] gap-y-2.5 text-sm">
              {profile.languages.map((l) => (
                <>
                  <dt class="text-fg">{l.name}</dt>
                  <dd class="font-mono text-xs text-muted">{l.level}</dd>
                </>
              ))}
            </dl>
          </div>
        )}
        {profile.hobbies.length > 0 && (
          <div class="card reveal p-5">
            <h2 class="font-mono text-sm font-medium text-fg">
              <span class="text-accent">#</span> off-duty
            </h2>
            <ul class="mt-4 flex flex-wrap gap-1.5">
              {profile.hobbies.map((h) => (
                <li class="chip">{h}</li>
              ))}
            </ul>
          </div>
        )}
      </section>
    )}

    <section class="mt-24">
      <ContactBlock />
    </section>
  </div>
</BaseLayout>
