---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import TerminalWindow from '@/components/terminal/TerminalWindow.astro';
import { getUses } from '@/lib/data.ts';
import { slugify } from '@/lib/slug.ts';

const groups = getUses();
const total = groups.reduce((n, g) => n + g.items.length, 0);
---

<BaseLayout title="Uses" description="The tools, technologies and setup I use every day.">
  <div class="container-page pt-12 sm:pt-16">
    <SectionHeading
      level={1}
      command="rudractl uses --tree"
      title="Uses"
      description="The tools and technologies I reach for — at work, in the lab and at my desk."
    />

    <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-3">
      {groups.map((group, i) => {
        const dir = slugify(group.group);
        return (
          <TerminalWindow
            title={`~/uses/${dir}`}
            class="enter flex flex-col"
            bodyClass="flex-1 !py-4 text-[0.8125rem]"
            style={`--i:${i}`}
          >
            <span slot="bar" class="ml-auto text-muted">
              {group.items.length}
            </span>
            <h2 class="mb-1.5 text-sm font-semibold text-accent-2">{dir}/</h2>
            <ul class="uses-tree" aria-label={group.group}>
              {group.items.map((item, j) => (
                <li class="uses-row">
                  <span class="uses-branch" aria-hidden="true">
                    {j === group.items.length - 1 ? '└──' : '├──'}
                  </span>
                  <span class="uses-name">{item.name}</span>
                  {item.note && <span class="uses-note"># {item.note}</span>}
                </li>
              ))}
            </ul>
          </TerminalWindow>
        );
      })}
    </div>

    <p class="enter mt-8 text-[0.8125rem] text-muted" style={`--i:${groups.length}`}>
      {groups.length} directories, {total} tools
    </p>
  </div>
</BaseLayout>

<style>
  .uses-tree {
    display: grid;
    gap: 0.1rem;
  }
  .uses-row {
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: 0.6rem;
    align-items: baseline;
    padding: 0.2rem 0.4rem;
    margin-inline: -0.4rem;
    border-radius: 0.35rem;
    transition: background 0.15s;
  }
  .uses-row:hover {
    background: var(--surface-hover);
  }
  .uses-row:hover .uses-name {
    color: var(--accent);
  }
  .uses-branch {
    grid-row: span 2;
    color: var(--border-strong);
  }
  .uses-name {
    color: var(--text-primary);
    transition: color 0.15s;
  }
  .uses-note {
    grid-column: 2;
    font-size: 0.75rem;
    color: var(--text-muted);
  }
</style>
