---
import Icon from './Icon.astro';
import { getProfile } from '@/lib/data.ts';

const { contact } = getProfile();
---

<dialog
  id="command-palette"
  aria-label="Search and commands"
  class="m-auto mt-[12vh] w-[min(40rem,calc(100vw-2rem))] max-w-none overflow-hidden rounded-xl border border-border-strong bg-surface-elevated p-0 text-fg shadow-2xl backdrop:bg-black/50 backdrop:backdrop-blur-sm"
  data-email={contact.email ?? ''}
  data-github={contact.github ?? ''}
>
  <form method="dialog" class="flex items-center gap-3 border-b border-border px-4" role="search">
    <span class="font-mono text-sm text-accent" aria-hidden="true">
      ❯
    </span>
    <input
      type="text"
      name="q"
      autocomplete="off"
      spellcheck="false"
      placeholder="Search posts, projects, labs… or type a command"
      class="h-14 flex-1 bg-transparent font-mono text-sm outline-none placeholder:text-muted"
      role="combobox"
      aria-expanded="true"
      aria-controls="palette-results"
      aria-autocomplete="list"
      data-palette-input
    />
    <kbd class="kbd">esc</kbd>
  </form>
  <ul
    id="palette-results"
    role="listbox"
    class="max-h-[min(60vh,28rem)] overflow-y-auto p-2"
    data-palette-results
  ></ul>
  <div class="flex items-center justify-between gap-4 border-t border-border px-4 py-2.5 font-mono text-[0.7rem] text-muted">
    <span class="flex items-center gap-3">
      <span>
        <kbd class="kbd">↑</kbd> <kbd class="kbd">↓</kbd> navigate
      </span>
      <span>
        <kbd class="kbd">↵</kbd> open
      </span>
    </span>
    <span class="flex items-center gap-1.5">
      <Icon name="terminal" size={12} /> rudractl search
    </span>
  </div>
</dialog>

<script>
  import { initPalette } from '@/scripts/palette.ts';
  initPalette();
</script>

<style is:global>
  #command-palette[open] {
    animation: palette-in 0.16s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  @keyframes palette-in {
    from {
      opacity: 0;
      transform: translateY(-6px) scale(0.985);
    }
  }
  [data-palette-results] [aria-selected='true'] {
    background: var(--surface-hover);
    color: var(--text-primary);
  }
  [data-palette-results] [aria-selected='true'] .palette-enter {
    opacity: 1;
  }
</style>
