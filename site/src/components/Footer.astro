---
import Icon from './Icon.astro';
import { getProfile } from '@/lib/data.ts';
import { getSocialLinks, sourceRepo } from '@/lib/site.ts';

const profile = getProfile();
const links = getSocialLinks({ rss: true }).filter((l) => l.id !== 'email');
const year = new Date().getFullYear();
const sha = (process.env['GITHUB_SHA'] ?? '').slice(0, 7);
const repo = sourceRepo();
const built = new Date().toISOString().slice(0, 16).replace('T', ' ');
---

<footer class="mt-24 border-t border-border">
  <div class="container-page grid gap-6 py-10 font-mono text-[0.8125rem] text-muted">
    <p class="text-fg-2">
      <span class="text-accent">$</span> echo "{profile.site.footer_message}"
    </p>

    <div class="flex flex-wrap items-center justify-between gap-4">
      <ul class="flex flex-wrap items-center gap-x-1 gap-y-2">
        {links.map((link, i) => (
          <li class="flex items-center gap-1">
            {i > 0 && <span aria-hidden="true">·</span>}
            <a
              href={link.href}
              data-track="contact_click"
              data-track-label={link.id}
              class="inline-flex items-center gap-1.5 rounded px-1 py-0.5 hover:text-fg"
            >
              <Icon name={link.id} size={13} />
              {link.label}
            </a>
          </li>
        ))}
      </ul>
      <a href="#main" class="inline-flex items-center gap-1.5 hover:text-fg">
        <Icon name="arrow-up" size={13} /> top
      </a>
    </div>

    <div class="flex flex-wrap items-center justify-between gap-2 text-xs">
      <p>
        © {year} {profile.name}
      </p>
      <p>
        built {built} UTC
        {sha && (
          <>
            {' · '}
            <a
              class="hover:text-fg"
              href={`https://github.com/${repo}/commit/${process.env['GITHUB_SHA']}`}
            >
              {sha}
            </a>
          </>
        )}
        {' · '}
        <a class="hover:text-fg" href={`https://github.com/${repo}`}>
          source
        </a>
      </p>
    </div>
  </div>
</footer>
