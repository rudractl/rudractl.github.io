---
/**
 * Free visitor analytics, configured in content/profile.yaml → site.analytics.
 * Renders nothing in dev or when no IDs are set.
 */
import { getProfile } from '@/lib/data.ts';

const analytics = getProfile().site.analytics;
const ga = import.meta.env.PROD ? analytics?.google_analytics : undefined;
const clarity = import.meta.env.PROD ? analytics?.clarity : undefined;
---

{ga && (
  <>
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${ga}`} />
    <script is:inline define:vars={{ ga }}>
      window.dataLayer = window.dataLayer || [];
      window.gtag = function () {
        dataLayer.push(arguments);
      };
      gtag('js', new Date());
      gtag('config', ga);
    </script>
  </>
)}
{clarity && <script is:inline define:vars={{ clarity }}>
  (function (c, l, a, r, i, t, y) {
    c[a] =
      c[a] ||
      function () {
        (c[a].q = c[a].q || []).push(arguments);
      };
    t = l.createElement(r);
    t.async = 1;
    t.src = 'https://www.clarity.ms/tag/' + i;
    y = l.getElementsByTagName(r)[0];
    y.parentNode.insertBefore(t, y);
  })(window, document, 'clarity', 'script', clarity);
</script>}
