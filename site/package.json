{
  "name": "rudractl.github.io",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Rudradev Pal — personal engineering portfolio. Git is the CMS.",
  "scripts": {
    "dev": "npm run sync --silent && astro dev",
    "build": "astro build",
    "prebuild": "npm run sync --silent",
    "postbuild": "node scripts/check-links.ts",
    "preview": "astro preview",
    "new": "node scripts/new.ts",
    "validate": "node scripts/validate.ts",
    "sync": "node scripts/fetch-github.ts && node scripts/import-medium.ts",
    "fetch:github": "node scripts/fetch-github.ts",
    "import:medium": "node scripts/import-medium.ts",
    "schemas": "node scripts/gen-schemas.ts",
    "typecheck": "astro check",
    "lint": "prettier --check . && markdownlint-cli2 \"../content/**/*.{md,mdx}\" \"../README.md\"",
    "format": "prettier --write .",
    "test": "node --test \"tests/**/*.test.ts\"",
    "check": "npm run validate && npm run lint && npm run typecheck && npm run build && npm test"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/markdown-satteri": "^0.4.3",
    "@astrojs/mdx": "^8.0.3",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.8",
    "github-slugger": "^2.0.0",
    "reading-time": "^1.5.0",
    "satori": "^0.56.1",
    "satteri": "^0.10.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "markdownlint-cli2": "^0.23.3",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1"
  },
  "engines": {
    "node": ">=22.18"
  }
}
