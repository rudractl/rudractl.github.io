{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "name": {
        "type": "string",
        "minLength": 1
      },
      "slug": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "status": {
        "default": "active",
        "type": "string",
        "enum": ["planned", "active", "complete", "paused"]
      },
      "technologies": {
        "default": [],
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "summary": {
        "type": "string",
        "minLength": 1
      },
      "repository": {
        "type": ["string", "null"]
      },
      "started": {
        "anyOf": [
          {
            "type": "integer",
            "minimum": 1900,
            "maximum": 2100
          },
          {
            "type": "string",
            "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$"
          }
        ]
      },
      "featured": {
        "default": false,
        "type": "boolean"
      },
      "notes": {
        "type": "string"
      }
    },
    "required": ["name", "summary"]
  }
}
