{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "published": {},
    "updated": {},
    "status": {
      "default": "published",
      "type": "string",
      "enum": [
        "draft",
        "published"
      ]
    },
    "tags": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "series": {
      "type": [
        "string",
        "null"
      ]
    },
    "featured": {
      "default": false,
      "type": "boolean"
    },
    "reading_time": {
      "default": "auto",
      "anyOf": [
        {
          "type": "string",
          "const": "auto"
        },
        {
          "type": "number",
          "exclusiveMinimum": 0
        }
      ]
    },
    "projects": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "cover": {
      "type": "string"
    },
    "external_url": {
      "type": "string",
      "format": "uri"
    }
  },
  "required": [
    "title",
    "description",
    "published"
  ]
}
