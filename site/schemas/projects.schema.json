{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "github": {
      "default": {
        "owners": [],
        "include_forks": false,
        "hide": []
      },
      "type": "object",
      "properties": {
        "owners": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "include_forks": {
          "default": false,
          "type": "boolean"
        },
        "hide": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "projects": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "slug": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "repository": {
                "type": "string",
                "pattern": "^[\\w.-]+\\/[\\w.-]+$"
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "long_description": {
                "type": "string"
              },
              "featured": {
                "default": false,
                "type": "boolean"
              },
              "status": {
                "default": "active",
                "type": "string",
                "enum": [
                  "active",
                  "maintenance",
                  "experimental",
                  "archived"
                ]
              },
              "role": {
                "default": "creator",
                "type": "string",
                "enum": [
                  "creator",
                  "maintainer",
                  "contributor"
                ]
              },
              "technologies": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "categories": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "order": {
                "default": 100,
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "links": {
                "default": {},
                "type": "object",
                "properties": {
                  "documentation": {
                    "anyOf": [
                      {
                        "type": "string",
                        "format": "uri"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "website": {
                    "anyOf": [
                      {
                        "type": "string",
                        "format": "uri"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                }
              },
              "highlights": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "why": {
                "type": "string"
              },
              "architecture": {
                "type": "string"
              },
              "decisions": {
                "type": "string"
              },
              "learned": {
                "type": "string"
              }
            },
            "required": [
              "repository"
            ]
          }
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false
}
