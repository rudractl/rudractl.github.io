{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "handle": {
      "type": "string",
      "minLength": 1
    },
    "role": {
      "type": "string",
      "minLength": 1
    },
    "tagline": {
      "type": "string",
      "minLength": 1
    },
    "location": {
      "type": "string"
    },
    "availability": {
      "type": "string"
    },
    "intro": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "focus": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "interests": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "icon": {
            "type": "string"
          }
        },
        "required": [
          "title",
          "description"
        ]
      }
    },
    "contact": {
      "type": "object",
      "properties": {
        "github": {
          "type": "string"
        },
        "linkedin": {
          "type": "string"
        },
        "email": {
          "type": "string",
          "format": "email",
          "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
        },
        "medium": {
          "type": "string"
        },
        "x": {
          "type": "string"
        },
        "mastodon": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "achievements": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "issuer": {
            "type": "string"
          }
        },
        "required": [
          "title"
        ]
      }
    },
    "languages": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "level": {
            "type": "string"
          }
        },
        "required": [
          "name"
        ]
      }
    },
    "hobbies": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "site": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "footer_message": {
          "default": "Built with Astro, Git and too much YAML.",
          "type": "string"
        },
        "analytics": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "google_analytics": {
                  "type": "string",
                  "pattern": "^G-[A-Z0-9]+$"
                },
                "clarity": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+$"
                }
              },
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "title",
        "description"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "name",
    "handle",
    "role",
    "tagline",
    "intro",
    "summary",
    "focus",
    "contact",
    "site"
  ]
}
