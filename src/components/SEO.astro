---
import { getProfile } from '@/lib/data.ts';

export interface SEOProps {
  title?: string | undefined;
  description?: string | undefined;
  /** Path of the social card, e.g. "/og/blog/rke2-airgap.png" */
  image?: string | undefined;
  type?: 'website' | 'article' | 'profile';
  published?: Date | undefined;
  updated?: Date | undefined;
  tags?: string[] | undefined;
  noindex?: boolean | undefined;
  jsonLd?: Record<string, unknown> | undefined;
}

const profile = getProfile();
const {
  title,
  description = profile.site.description.trim(),
  image = '/og/default.png',
  type = 'website',
  published,
  updated,
  tags = [],
  noindex = false,
  jsonLd,
} = Astro.props as SEOProps;

const fullTitle = title ? `${title} · ${profile.name}` : profile.site.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(image, Astro.site);

const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: profile.role,
  url: Astro.site?.toString(),
  sameAs: [
    profile.contact.github && `https://github.com/${profile.contact.github}`,
    profile.contact.linkedin && `https://www.linkedin.com/in/${profile.contact.linkedin}`,
  ].filter(Boolean),
};
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex" />}

<meta property="og:type" content={type} />
<meta property="og:site_name" content={profile.name} />
<meta property="og:title" content={title ?? profile.site.title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={title ?? profile.site.title} />
<meta property="og:locale" content="en" />
{published && <meta property="article:published_time" content={published.toISOString()} />}
{updated && <meta property="article:modified_time" content={updated.toISOString()} />}
{type === 'article' && <meta property="article:author" content={profile.name} />}
{tags.map((tag) => (
  <meta property="article:tag" content={tag} />
))}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title ?? profile.site.title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
{profile.contact.x && <meta name="twitter:creator" content={`@${profile.contact.x}`} />}

<script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd ?? personLd)} />
