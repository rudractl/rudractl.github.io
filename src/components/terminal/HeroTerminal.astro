---
import TerminalWindow from './TerminalWindow.astro';
import Icon from '../Icon.astro';
import { getProfile, getUses } from '@/lib/data.ts';
import { getLabs, getPosts, getProjects } from '@/lib/content.ts';
import { getSocialLinks } from '@/lib/site.ts';

const profile = getProfile();
const [projects, posts, labs] = await Promise.all([getProjects(), getPosts(), getLabs()]);

// Data for the optional interactive prompt (easter eggs live in scripts/terminal.ts)
const termData = {
  name: profile.name,
  role: profile.role,
  tagline: profile.tagline.trim(),
  location: profile.location,
  focus: profile.focus,
  contact: getSocialLinks({ rss: true }).map(({ id, display, href }) => ({ id, display, href })),
  projects: projects.map((p) => ({
    name: p.data.name,
    href: `/opensource/${p.id}/`,
    status: p.data.status,
    description: p.data.description.trim(),
  })),
  posts: posts.slice(0, 6).map((p) => ({
    title: p.data.title,
    href: `/blog/${p.id}/`,
    date: p.data.published.toISOString().slice(0, 10),
  })),
  labs: labs.map((l) => ({ name: l.data.name, href: `/lab/${l.id}/`, status: l.data.status })),
  uses: getUses().map((g) => ({ group: g.group, items: g.items.map((i) => i.name) })),
};
---

<TerminalWindow
  title={`${profile.handle} — zsh — 80×24`}
  class="relative"
  bodyClass="min-h-[22rem]"
>
  <span slot="bar" class="ml-auto hidden items-center gap-1.5 sm:flex">
    <span class="status status-active">online</span>
  </span>

  <script is:inline>
    // Animate once per session, only when motion is welcome. Runs before paint.
    (() => {
      try {
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        if (sessionStorage.getItem('hero-typed')) return;
        const root = document.documentElement;
        root.classList.add('hero-typing');
        // Safety net: never keep content hidden if the script fails to load.
        setTimeout(() => root.classList.remove('hero-typing'), 2500);
      } catch {}
    })();
  </script>
  <div data-hero>
    <p class="font-mono">
      <span class="hidden sm:inline">
        <span class="ps1">rudra@platform</span>
        <span class="text-muted">:</span>
        <span class="ps1-path">~</span>
      </span>
      <span class="ps1">$ </span>
      <span class="text-fg" data-type-target data-text={`${profile.handle} whoami`}>
        {profile.handle} whoami
      </span>
      <span class="cursor hero-type-cursor" aria-hidden="true"></span>
    </p>

    <div class="hero-output mt-5 space-y-5" data-hero-output>
      <div class="enter" style="--i:0">
        <h1 class="font-sans text-4xl font-semibold tracking-tight text-fg sm:text-5xl">
          {profile.name}
        </h1>
        <p class="mt-2 font-sans text-lg text-accent sm:text-xl">{profile.role}</p>
      </div>
      <p
        class="enter max-w-xl font-sans text-base leading-relaxed text-fg-2 sm:text-[1.0625rem]"
        style="--i:1"
      >
        {profile.tagline}
      </p>
      <ul class="enter grid gap-0.5 text-fg-2" style="--i:2" aria-label="Focus areas">
        {profile.focus.map((item) => (
          <li>
            <span class="text-accent">&gt;</span> {item}
          </li>
        ))}
      </ul>
      <div class="enter flex flex-wrap gap-3 pt-1" style="--i:3">
        <a href="/opensource/" class="btn btn-primary">
          <Icon name="code" size={15} /> Explore Open Source
        </a>
        <a href="/blog/" class="btn">
          <Icon name="book" size={15} /> Read Blog
        </a>
      </div>
    </div>

    <div
      class="hero-output mt-6 border-t border-dashed border-border pt-4 text-[0.8125rem]"
      data-term
    >
      <div data-term-log aria-live="polite" class="space-y-1 empty:hidden"></div>
      <form class="flex items-center" data-term-form>
        <label for="term-input" class="sr-only">
          Optional terminal — type help
        </label>
        <span class="ps1 shrink-0" aria-hidden="true">
          $&nbsp;
        </span>
        <input
          id="term-input"
          data-term-input
          type="text"
          autocomplete="off"
          autocapitalize="off"
          spellcheck="false"
          placeholder="type 'help' — or just scroll, that works too"
          class="w-full min-w-0 bg-transparent text-fg caret-accent outline-none placeholder:text-muted/80"
        />
      </form>
    </div>
  </div>

  <script type="application/json" id="term-data" set:html={JSON.stringify(termData)} />
</TerminalWindow>

<script>
  import { initHeroTerminal } from '@/scripts/terminal.ts';
  initHeroTerminal();
</script>

<style is:global>
  .hero-type-cursor {
    display: none;
  }
  .hero-typing .hero-type-cursor {
    display: inline-block;
  }
  .hero-typing [data-type-target] {
    visibility: hidden;
  }
  .hero-typing [data-type-target][data-typing] {
    visibility: visible;
  }
  .hero-typing .hero-output {
    display: none;
  }
</style>
