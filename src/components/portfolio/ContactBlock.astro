---
import TerminalWindow from '../terminal/TerminalWindow.astro';
import Prompt from '../terminal/Prompt.astro';
import Icon from '../Icon.astro';
import { getProfile } from '@/lib/data.ts';
import { getSocialLinks } from '@/lib/site.ts';

const profile = getProfile();
const links = getSocialLinks();
---

<div class="grid items-center gap-8 lg:grid-cols-[1fr_1.1fr]">
  <div>
    <p class="eyebrow mb-3">
      <span class="prompt">$</span> rudractl contact
    </p>
    <h2 class="text-2xl font-semibold tracking-tight sm:text-3xl">Let's talk infrastructure.</h2>
    <p class="mt-3 max-w-md leading-relaxed text-fg-2">
      {profile.availability ?? 'Always happy to chat about Kubernetes, platforms and automation.'}
      The fastest way to reach me is below.
    </p>
  </div>
  <TerminalWindow title="contact — zsh">
    <Prompt command="rudractl contact" short="contact" />
    <dl class="mt-3 grid grid-cols-[5.5rem_1fr] gap-y-2 text-[0.8125rem] sm:grid-cols-[7rem_1fr]">
      {links.map((link) => (
        <>
          <dt class="flex items-center gap-2 text-accent">
            <Icon name={link.id} size={13} />
            {link.id}
          </dt>
          <dd class="min-w-0 truncate">
            <a href={link.href} class="link" data-track="contact_click" data-track-label={link.id}>
              {link.display}
            </a>
          </dd>
        </>
      ))}
    </dl>
  </TerminalWindow>
</div>
