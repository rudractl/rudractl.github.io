---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import ArticleRow from '@/components/blog/ArticleRow.astro';
import Icon from '@/components/Icon.astro';
import { getPosts, getTags } from '@/lib/content.ts';

const posts = await getPosts();
const tags = await getTags();
---

<BaseLayout
  title="Blog"
  description="Engineering notes on Kubernetes, platform engineering, infrastructure and automation."
>
  <div class="container-page pt-12 sm:pt-16">
    <SectionHeading
      level={1}
      command="rudractl blog list"
      title="Engineering Notes"
      description="Long-form writing on Kubernetes, platform engineering, infrastructure and the experiments in between."
    />

    <div class="enter mb-8 grid gap-4" data-blog-filters>
      <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
        <label class="flex h-11 flex-1 items-center gap-2.5 rounded-lg border border-border bg-surface px-3.5 font-mono text-sm focus-within:border-accent/60">
          <span class="text-accent" aria-hidden="true">
            grep
          </span>
          <span class="sr-only">Search posts</span>
          <input
            type="search"
            data-blog-search
            placeholder="search titles, tags and content…"
            class="h-full flex-1 bg-transparent text-fg outline-none placeholder:text-muted"
          />
        </label>
        <div class="flex items-center gap-2">
          <button
            type="button"
            class="chip h-11 px-3.5"
            data-blog-sort
            aria-label="Toggle sort order"
          >
            <Icon name="clock" size={13} /> <span data-sort-label>newest</span>
          </button>
          <a href="/rss.xml" class="chip h-11 px-3.5" aria-label="RSS feed">
            <Icon name="rss" size={13} /> rss
          </a>
        </div>
      </div>
      {tags.length > 0 && (
        <ul class="flex flex-wrap gap-2" aria-label="Filter by tag">
          {tags.map(({ tag, slug, count }) => (
            <li>
              <a
                href={`/blog/tags/${slug}/`}
                class="chip"
                data-tag-filter={slug}
                aria-pressed="false"
              >
                #{tag} <span class="text-muted">{count}</span>
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>

    <p class="mb-4 font-mono text-xs text-muted" aria-live="polite" data-blog-count>
      {posts.length} posts
    </p>

    <div data-blog-list>
      {posts.map((post) => (
        <ArticleRow post={post} filterable headingLevel="h2" />
      ))}
    </div>
    <p class="hidden py-16 text-center font-mono text-sm text-muted" data-blog-empty>
      grep: no matches.{' '}
      <button type="button" class="link" data-blog-reset>
        clear filters
      </button>
    </p>
  </div>
</BaseLayout>

<script>
  const list = document.querySelector<HTMLElement>('[data-blog-list]');
  const search = document.querySelector<HTMLInputElement>('[data-blog-search]');
  const count = document.querySelector<HTMLElement>('[data-blog-count]');
  const empty = document.querySelector<HTMLElement>('[data-blog-empty]');
  const sortBtn = document.querySelector<HTMLButtonElement>('[data-blog-sort]');
  const sortLabel = document.querySelector<HTMLElement>('[data-sort-label]');
  const tagButtons = [...document.querySelectorAll<HTMLAnchorElement>('[data-tag-filter]')];
  const posts = [...document.querySelectorAll<HTMLElement>('[data-post]')];
  const active = new Set<string>();

  const params = new URLSearchParams(location.search);
  if (search && params.get('q')) search.value = params.get('q') ?? '';
  params.getAll('tag').forEach((t) => active.add(t));

  function apply() {
    const terms = (search?.value ?? '').toLowerCase().split(/\s+/).filter(Boolean);
    let shown = 0;
    for (const post of posts) {
      const text = post.dataset['search'] ?? '';
      const tags = (post.dataset['tags'] ?? '').split(' ');
      const ok = terms.every((t) => text.includes(t)) && [...active].every((t) => tags.includes(t));
      post.hidden = !ok;
      if (ok) shown++;
    }
    tagButtons.forEach((b) =>
      b.setAttribute('aria-pressed', String(active.has(b.dataset['tagFilter'] ?? ''))),
    );
    if (count)
      count.textContent = `${shown} ${shown === 1 ? 'post' : 'posts'}${terms.length || active.size ? ' matching' : ''}`;
    empty?.classList.toggle('hidden', shown > 0);
    const url = new URL(location.href);
    url.searchParams.delete('tag');
    url.searchParams.delete('q');
    if (search?.value) url.searchParams.set('q', search.value);
    active.forEach((t) => url.searchParams.append('tag', t));
    history.replaceState(null, '', url);
  }

  search?.addEventListener('input', apply);
  tagButtons.forEach((btn) =>
    btn.addEventListener('click', (e) => {
      e.preventDefault(); // JS: filter in place. No JS: the link goes to the tag page.
      const tag = btn.dataset['tagFilter'] ?? '';
      if (active.has(tag)) active.delete(tag);
      else active.add(tag);
      apply();
    }),
  );
  sortBtn?.addEventListener('click', () => {
    if (!list) return;
    [...list.children].reverse().forEach((el) => list.append(el));
    if (sortLabel) sortLabel.textContent = sortLabel.textContent === 'newest' ? 'oldest' : 'newest';
  });
  document.querySelector('[data-blog-reset]')?.addEventListener('click', () => {
    if (search) search.value = '';
    active.clear();
    apply();
  });
  if (search?.value || active.size) apply();
</script>
